<%= render :partial => 'auto_sync', :locals => {
      :schedule => @ldap_setting,
      :url      => update_schedule_ldap_setting_path(@ldap_setting),
      :prefix   => 'schedule',
      :title    => l(:label_auto_sync) } %>

<hr style="margin:20px 0; border:none; border-top:1px solid #e0e0e0;">

<%= render :partial => 'auto_sync', :locals => {
      :schedule => LdapSync::LocalSchedule.find(@ldap_setting.id),
      :url      => update_local_schedule_ldap_setting_path(@ldap_setting),
      :prefix   => 'local_schedule',
      :title    => l(:label_auto_sync_local),
      :hint     => safe_join([l(:label_auto_sync_local_hint), tag.br,
                              l(:label_auto_sync_local_node, :host => LdapSync::LocalSchedule.hostname, :path => LdapSync::LocalSchedule.path)]) } %>

<hr style="margin:20px 0; border:none; border-top:1px solid #e0e0e0;">

<div class="box tabular settings">
  <h3><%= l(:label_manual_sync) %></h3>
  <p style="color:#666; font-size:0.9em;"><%= l(:label_manual_sync_hint) %></p>
  <p>
    <button type="button" id="run-now-btn" class="icon icon-play"
            data-url="<%= run_now_ldap_setting_path(@ldap_setting) %>">
      <%= l(:button_run_now) %>
    </button>
    <span id="run-now-spinner" style="display:none; margin-left:8px;">⏳ Running...</span>
  </p>
  <div id="run-now-result" style="display:none; margin-top:8px;">
    <pre id="run-now-output"></pre>
  </div>
</div>
